[linux:vars]
# The lab used password auth. The tool uses the key path instead (see the
# architecture notes): ansible_ssh_private_key_file after ssh-copy-id in phase 50.
ansible_user=configuser
ansible_password=<REDACTED>
#ansible_ssh_private_key_file=
